{
  "name": "chinotto-mobile",
  "version": "3.0.1",
  "private": true,
  "description": "A pocket for thoughts, encounters, and what comes back.",
  "license": "SEE LICENSE IN LICENSE",
  "author": "Aleksandr Malinin",
  "homepage": "https://getchinotto.app",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/probnaya-work/chinotto-mobile.git"
