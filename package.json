    "@types/node": "~25.5.0",
    "@types/react": "~19.3.0",
    "dotenv": "^17.3.1",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "react-test-renderer": "19.3.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-notifications",
          "expo-application"
