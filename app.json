{
  "expo": {
    "name": "Chinotto",
    "owner": "bogart-labs",
    "slug": "chinotto-mobile",
    "version": "2.0.0",
    "scheme": "chinotto",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#141416"
    },
    "ios": {
      "supportsTablet": false,
      "buildNumber": "6",
      "bundleIdentifier": "com.chinotto.mobile",
      "googleServicesFile": "./GoogleService-Info.plist",
      "associatedDomains": ["applinks:getchinotto.app"],
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.chinotto.mobile"
        ]
      },
      "infoPlist": {
        "UIDeviceFamily": [1],
        "ITSAppUsesNonExemptEncryption": false,
        "NSMicrophoneUsageDescription": "Chinotto uses the microphone so you can hold the circle and speak instead of typing. The recording itself is kept on this iPhone as part of your record, so you can hear a moment back later — not only read what was heard.",
        "NSPhotoLibraryUsageDescription": "Chinotto uses your photo library when you share images or other media into the app, or when you pick an image to include in capture. Your library is not read in the background.",
        "NSSpeechRecognitionUsageDescription": "Chinotto turns what you say into text on this iPhone, as a first draft of the words. The recording stays on the device and remains the original."
      }
    },
    "android": {
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#141416",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.chinotto.mobile",
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_SETTINGS",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "75f836d7-4d98-401b-a733-0ac61429d31e",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.chinotto.mobile.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.chinotto.mobile"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "@react-native-firebase/app",
      "expo-apple-authentication",
      "expo-sqlite",
      [
        "expo-widgets",
        {
          "groupIdentifier": "group.com.chinotto.mobile",
          "bundleIdentifier": "com.chinotto.mobile.ExpoWidgetsTarget",
          "widgets": [
            {
              "name": "CaptureHomeWidget",
              "displayName": "Chinotto",
              "description": "Open capture to jot a thought.",
              "supportedFamilies": [
                "systemSmall",
                "systemMedium"
              ]
            }
          ]
        }
      ],
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroups": ["group.com.chinotto.mobile"],
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 5,
              "supportsWebPageWithMaxCount": 5
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/plain",
              "text/*"
            ],
            "multipleShareMimeTypes": [
              "text/plain",
              "text/*"
            ]
          }
        }
      ],
      [
        "./plugins/withIosSplashLogoFixedConstraints.js",
        {
          "imageWidth": 120
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#141416",
          "resizeMode": "contain",
          "imageWidth": 120
        }
      ]
    ]
  }
}
